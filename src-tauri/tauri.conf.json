{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruyd",
  "version": "0.2.0",
  "identifier": "com.ruyd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ruyd",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "additionalBrowserArgs": "--disable-background-timer-throttling"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": "all",
    "shortDescription": "Encrypted direct chat with friends",
    "longDescription": "Ruyd connects friends over encrypted direct WebRTC channels without port forwarding or relaying their traffic."
  }
}
